<!DOCTYPE html>
<html lang="{{@site.locale}}" class="tb-js-pending">
<head>
    {{!--
      HEAD
      Ghost injects most metadata — Open Graph, JSON-LD, canonical, the
      accent colour variable — through ghost_head, so the theme's own head
      stays small: charset, the title, the no-flash theme script, and one
      stylesheet.
    --}}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    {{!--
      NO-FLASH THEME
      Inline and blocking on purpose: a deferred script runs after first
      paint, which means a reader who chose dark gets a white flash on every
      navigation. ~15 lines; cheaper than the flash.

      The publisher's default comes from the Design settings; a reader's own
      choice, stored under tb-scheme, always wins.
    --}}
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.remove('tb-js-pending');
        d.classList.add('tb-js');
        try {
          var pref = localStorage.getItem('tb-scheme') || '{{@custom.color_scheme}}';
          if (pref === 'light' || pref === 'dark') d.setAttribute('data-theme', pref);
        } catch (e) { /* private mode — the OS preference stands */ }
      })();
    </script>

    <link rel="stylesheet" href="{{asset "css/screen.css"}}">

    {{ghost_head}}
</head>
<body class="{{body_class}}">

    <a class="tb-skip-link" href="#main">Skip to content</a>

    {{!-- The icon sprite: inlined once, referenced everywhere as #tb-name. --}}
    {{> "icons"}}

    {{!--
      NAVBAR
      Two shapes from one skeleton, chosen in Design → Site-wide: the island
      (a floating pill) or the full bar. The reading-progress ring/hairline
      rides on it when enabled. Navigation itself is Ghost's — edit it in
      Settings → Navigation, and the {{navigation}} helper renders the
      partial in partials/navigation.hbs.
    --}}
    <header class="tb-navbar tb-navbar--{{@custom.navigation_layout}} tb-navbar--sticky tb-navbar--blur" data-tb-navbar>
        <div class="{{#match @custom.navigation_layout "full"}}tb-container-full{{else}}tb-container{{/match}}">
            <div class="tb-navbar__inner">

                <a class="tb-navbar__brand" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img class="tb-navbar__logo" src="{{img_url @site.logo size="xs"}}" alt="" width="28" height="28">
                    {{/if}}
                    <span class="tb-navbar__title">{{@site.title}}</span>
                </a>

                <div class="tb-navbar__menu" id="tb-nav-menu">
                    {{navigation}}
                </div>

                <div class="tb-navbar__actions">
                    {{!-- Ghost's own search (sodo-search) answers this button. --}}
                    <button type="button" class="tb-navbar__icon-btn" data-ghost-search
                            aria-label="Search this site">
                        <svg class="tb-icon tb-icon--md" aria-hidden="true"><use href="#tb-search"></use></svg>
                    </button>

                    <button type="button" class="tb-navbar__icon-btn" data-tb-theme-toggle
                            aria-label="Switch colour theme">
                        <span class="tb-theme-toggle__moon"><svg class="tb-icon tb-icon--md" aria-hidden="true"><use href="#tb-moon"></use></svg></span>
                        <span class="tb-theme-toggle__sun"><svg class="tb-icon tb-icon--md" aria-hidden="true"><use href="#tb-sun"></use></svg></span>
                    </button>

                    {{#if @custom.cta_text}}
                        <a class="tb-btn tb-btn--primary tb-btn--sm tb-hide-mobile" href="{{@custom.cta_url}}">{{@custom.cta_text}}</a>
                    {{/if}}

                    <button type="button" class="tb-navbar__icon-btn tb-navbar__burger"
                            data-tb-nav-toggle aria-expanded="false" aria-controls="tb-nav-menu"
                            aria-label="Open menu">
                        <span class="tb-navbar__burger-bars"></span>
                    </button>
                </div>

                {{#if @custom.show_reading_progress}}
                    <div class="tb-progress" data-tb-progress aria-hidden="true"></div>
                {{/if}}
            </div>
        </div>
    </header>

    <main id="main" tabindex="-1">
        {{{body}}}
    </main>

    {{> "footer"}}

    <script src="{{asset "js/theme.js"}}" defer></script>
    {{ghost_foot}}
</body>
</html>
