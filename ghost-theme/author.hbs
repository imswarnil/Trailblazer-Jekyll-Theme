{{!< default}}
{{!--
  AUTHOR — a person's page: their picture, bio and links from the Ghost
  profile, then everything they wrote.
--}}
{{#author}}
<div class="tb-container">
    <section class="tb-hero tb-hero--minimal">
        <div class="tb-author tb-author--hero">
            {{#if profile_image}}
                <img class="tb-author__avatar" src="{{img_url profile_image size="s"}}" alt="" width="72" height="72">
            {{/if}}
            <div>
                <p class="tb-hero__eyebrow">Author</p>
                <h1 class="tb-hero__title" style="font-size:var(--tb-text-3xl)">{{name}}</h1>
                {{#if bio}}<p class="tb-hero__lead">{{bio}}</p>{{/if}}
                <p class="tb-cluster-sm tb-mt-3">
                    {{#if location}}<span class="tb-badge">{{location}}</span>{{/if}}
                    {{#if website}}<a class="tb-btn tb-btn--soft tb-btn--sm" href="{{website}}" rel="noopener" target="_blank">Website</a>{{/if}}
                </p>
            </div>
        </div>
    </section>
</div>
{{/author}}

<div class="tb-container tb-section">
    <ol class="tb-numbered">
        {{#foreach posts}}
            {{> "post-row"}}
        {{/foreach}}
    </ol>

    {{pagination}}
</div>
