{{!< default}}
{{!--
  PAGE — a static page: About, Contact, anything from Ghost's Pages. The
  post shell minus the byline, the post nav and the comments, because a
  page is a place, not an entry in a stream.
--}}
{{#post}}
<article class="tb-container-prose tb-section {{post_class}}">

    {{!-- The editor's "Hide title and feature image" toggle is honoured. --}}
    {{#match @page.show_title_and_feature_image}}
        <header class="tb-post__header">
            <h1 class="tb-post__title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="tb-post__lead">{{custom_excerpt}}</p>
            {{/if}}
        </header>

        {{#if feature_image}}
            <figure class="tb-post__cover">
                <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"
                     loading="eager" decoding="async">
            </figure>
        {{/if}}
    {{/match}}

    <div class="tb-prose gh-content" data-tb-article>
        {{content}}
    </div>

</article>
{{/post}}
