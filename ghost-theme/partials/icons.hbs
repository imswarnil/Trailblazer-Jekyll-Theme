{{!--
  ICON SPRITE — inlined once at the top of <body>, referenced everywhere as
  <use href="#tb-name">. Inlined rather than fetched so icons are always
  there, inherit currentColor, and cost no request. Every symbol is a 24×24
  stroke drawing on one grid: 1.75 stroke, round caps and joins — the
  consistency is what makes a row of them read as one set.

  This is the Ghost subset of the Trailblazer sprite; add a symbol here the
  same way, keeping the grammar.
--}}
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true" focusable="false">
  <symbol id="tb-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M17.5 19H7a4.5 4.5 0 0 1-.6-8.96 5.5 5.5 0 0 1 10.5-1.2A4 4 0 0 1 17.5 19Z"/>
  </symbol>

  <symbol id="tb-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="10.8" cy="10.8" r="6.3"/>
    <path d="m15.5 15.5 4 4"/>
  </symbol>

  <symbol id="tb-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2.8v2M12 19.2v2M4.4 4.4l1.4 1.4M18.2 18.2l1.4 1.4M2.8 12h2M19.2 12h2M4.4 19.6l1.4-1.4M18.2 5.8l1.4-1.4"/>
  </symbol>

  <symbol id="tb-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z"/>
  </symbol>

  <symbol id="tb-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4.5 12h15M13.5 6l6 6-6 6"/>
  </symbol>

  <symbol id="tb-arrow-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>
  </symbol>

  <symbol id="tb-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3.5" y="5.5" width="17" height="15" rx="2"/>
    <path d="M3.5 10h17M8 3.5v4M16 3.5v4"/>
  </symbol>

  <symbol id="tb-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="8.5"/>
    <path d="M12 7v5.3l3.3 2"/>
  </symbol>

  <symbol id="tb-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="5.5" width="18" height="13" rx="2"/>
    <path d="m3.6 7 8.4 6 8.4-6"/>
  </symbol>

  <symbol id="tb-rss" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 5.5a13.5 13.5 0 0 1 13.5 13.5"/>
    <path d="M5 11a8 8 0 0 1 8 8"/>
    <circle cx="5.8" cy="18.2" r="1.6"/>
  </symbol>

  <symbol id="tb-x-social" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 4l16 16M20 4 4 20"/>
  </symbol>

  <symbol id="tb-facebook" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14.5 8.5h3v-4h-3a4.5 4.5 0 0 0-4.5 4.5v2.5H7v4h3v7h4v-7h3l.8-4H14v-2a1 1 0 0 1 .5-1Z"/>
  </symbol>
</svg>
