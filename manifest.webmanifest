---
layout: null
permalink: /manifest.webmanifest
sitemap: false
---
{
  "name": {{ site.pwa.name | default: site.title | jsonify }},
  "short_name": {{ site.pwa.short_name | default: site.title | jsonify }},
  "description": {{ site.description | strip_newlines | strip | jsonify }},
  "start_url": {{ '/' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": {{ site.pwa.display | default: 'standalone' | jsonify }},
  "theme_color": {{ site.pwa.theme_color | default: site.theme_style.accent | jsonify }},
  "background_color": {{ site.pwa.background_color | default: '#ffffff' | jsonify }},
  "lang": {{ site.lang | default: 'en' | jsonify }},
  "icons": [
    {
      "src": {{ '/assets/img/icon-192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/img/icon-512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/img/icon-maskable.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Blog", "url": {{ '/blog/' | relative_url | jsonify }} },
    { "name": "Resume", "url": {{ '/resume/' | relative_url | jsonify }} }
  ]
}
